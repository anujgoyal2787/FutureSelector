# FutureSelector Environment Variables Example
PORT=3000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/futureselector
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/futureselector?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/futureselector

# JWT Secret for Session Signing (Minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production

# Master Admin Key for initial Super Admin setup
ADMIN_SECRET_KEY=replace_with_a_secure_admin_master_key_for_super_admin

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Email Notifications (Gmail SMTP / Nodemailer)
# Use your Gmail address and 16-character App Password (https://myaccount.google.com/apppasswords)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com

# Razorpay Payment Gateway (Test / Live Credentials)
# Get keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
